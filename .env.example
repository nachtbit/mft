# Copy to .env.local for local work. Set the same names in Vercel. Never commit real values.
BOT_TOKEN=
# Comma-separated numeric Telegram user IDs.
ALLOWED_IDS=
# Random string, 32-256 characters of A-Z a-z 0-9 _ -  (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# Your production URL, starting with https://
APP_URL=
